		{
			"name": "Load Test - Sequential 1000 iterations",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Тесты для нагрузочного тестирования",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response time is acceptable', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(5000);",
							"});",
							"",
							"// Логируем время ответа для анализа",
							"console.log('Response time:', pm.response.responseTime + 'ms');",
							"",
							"// Сохраняем статистику",
							"const currentIteration = pm.info.iteration + 1;",
							"if (!pm.globals.get('totalResponseTime')) {",
							"    pm.globals.set('totalResponseTime', 0);",
							"    pm.globals.set('maxResponseTime', 0);",
							"    pm.globals.set('minResponseTime', Infinity);",
							"}",
							"",
							"const totalTime = pm.globals.get('totalResponseTime') + pm.response.responseTime;",
							"const maxTime = Math.max(pm.globals.get('maxResponseTime'), pm.response.responseTime);",
							"const minTime = Math.min(pm.globals.get('minResponseTime'), pm.response.responseTime);",
							"",
							"pm.globals.set('totalResponseTime', totalTime);",
							"pm.globals.set('maxResponseTime', maxTime);",
							"pm.globals.set('minResponseTime', minTime);",
							"",
							"// На последней итерации выводим статистику",
							"if (currentIteration === 1000) {",
							"    const avgTime = totalTime / 1000;",
							"    console.log('=== LOAD TEST RESULTS ===');",
							"    console.log('Total iterations: 1000');",
							"    console.log('Average response time:', avgTime.toFixed(2) + 'ms');",
							"    console.log('Max response time:', maxTime + 'ms');",
							"    console.log('Min response time:', minTime + 'ms');",
							"    console.log('========================');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded"
