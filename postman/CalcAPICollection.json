{
	"info": {
		"_postman_id": "calculator-api-collection",
		"name": "Calculator API Collection",
		"description": "Коллекция для тестирования API калькулятора с поддержкой различных систем счисления",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Pre-request script для формирования URL на основе environment",
					"const protocol = pm.environment.get('protocol');",
					"const host = pm.environment.get('host');",
					"const port = pm.environment.get('port');",
					"const apiPath = pm.environment.get('apiPath');",
					"",
					"// Формируем полный URL",
					"let baseUrl;",
					"if (port && port !== '443' && port !== '80') {",
					"    baseUrl = `${protocol}://${host}:${port}${apiPath}`;",
					"} else {",
					"    baseUrl = `${protocol}://${host}${apiPath}`;",
					"}",
					"",
					"// Устанавливаем переменную для использования в запросах",
					"pm.environment.set('fullApiUrl', baseUrl);",
					"",
					"console.log('Generated API URL:', baseUrl);"
				]
			}
		}
	],
	"item": [
		{
			"name": "Addition",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Позитивные тесты",
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('firstValue');",
							"    pm.expect(jsonData).to.have.property('secondValue');",
							"    pm.expect(jsonData).to.have.property('operation');",
							"    pm.expect(jsonData).to.have.property('resultValue');",
							"    pm.expect(jsonData).to.have.property('executedAt');",
							"});",
							"",
							"pm.test('Operation is ADD', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.operation).to.eql('ADD');",
							"});",
							"",
							"pm.test('Result is correct for decimal addition', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.resultValue).to.eql('15');",
							"});",
							"",
							"pm.test('Response time is less than 1000ms', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);",
							"});",
							"",
							"// Негативные тесты",
							"pm.test('Invalid input returns error', function () {",
							"    if (pm.response.code !== 200) {",
							"        pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
